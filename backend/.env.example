# 药知后端本地配置模板 —— 复制为 backend/.env 后按需填写（.gitignore 已排除 .env，不入库）
# 优先级：环境变量 > .env 文件 > 代码默认值
# 注意：跑测试前请清掉外部模型 key（或暂移 .env），否则真 key 会污染评测确定性。

# ---- 外部大模型（OpenAI 兼容接口；不配置时自动降级 Mock 规则引擎，功能不中断）----
# 阿里云百炼 DashScope Key（sk-xxx）；线上部署写在 /home/admin/yaozhi_env（不入库，见 deploy/cloud）。
YAOZHI_EXTERNAL_API_KEY=
# YAOZHI_EXTERNAL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# YAOZHI_EXTERNAL_MODEL=qwen3.7-flash
# YAOZHI_MODEL_PROVIDER=external_api    # mock | external_api（默认 external_api；无 key 自动退 Mock）

# ---- RAG 检索 ----
# YAOZHI_RAG_ENABLED=true
# YAOZHI_RAG_TOP_K=2
# YAOZHI_RAG_SEMANTIC_ENABLED=true      # 语义向量路（需先跑 backend/build_semantic_cache.py）
# YAOZHI_RAG_SEMANTIC_MIN_COS=0.45      # 语义命中余弦门槛（相关 0.58+，噪声 0.40-，实测校准）

# ---- 账号鉴权（本地默认关=开发/测试零改动；docker-compose 部署已置 1）----
# YAOZHI_AUTH_REQUIRED=0
# YAOZHI_ADMIN_KEY=                     # 护 /admin/* 与 /eval/run（X-Admin-Key 头）
# YAOZHI_INVITE_CODE=DEMO2026

# ---- 数据库 ----
# YAOZHI_DATABASE_URL=sqlite:///./yaozhi_w1.db
